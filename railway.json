{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "mvn clean package -DskipTests"
    },
    "deploy": {
        "numReplicas": 1,
        "startCommand": "java -jar target/GymAssist-0.0.1-SNAPSHOT.jar --server.port=$PORT",
        "healthcheckPath": "/",
        "restartPolicyType": "ON_FAILURE"
    }
}
