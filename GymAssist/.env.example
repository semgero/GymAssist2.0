# =====================================================================
# Variables de entorno de GymAssist (Spring Boot) — PLANTILLA SIN VALORES REALES
# - En local: los valores reales van en  GymAssist/.env  (ese NO se sube a GitHub).
# - En Railway: servicio GymAssist2.0 > Variables > Raw Editor.
# Formato: sin comillas y sin comentarios al final de la línea.
# =====================================================================

# --- MongoDB Atlas (datos principales) ---
MONGODB_URL=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/gymassist_nosql?tls=true

# --- PostgreSQL en Railway ---
# Ojo: la URL va SIN usuario ni clave: jdbc:postgresql://HOST:PUERTO/railway
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST.proxy.rlwy.net:PUERTO/railway
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CLAVE

# --- Redis en Railway (REDIS_PUBLIC_URL) ---
SPRING_DATA_REDIS_URL=redis://default:CLAVE@HOST.proxy.rlwy.net:PUERTO

# --- AWS S3 (fotos de las rutinas) ---
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-2
AWS_BUCKET=nombre-del-bucket

# --- Mercado Pago (pago de membresías). En pruebas empieza por TEST- ---
MP_ACCESS_TOKEN=APP_USR-...
MP_PUBLIC_KEY=APP_USR-...

# --- Groq (chatbot) ---
GROQ_API_KEY=gsk_...

# --- API de predicción en Python (FastAPI + TensorFlow) ---
ML_API_URL=http://localhost:8000
# En Railway: false
ML_API_AUTOSTART=true

# --- Dominio público (URLs de regreso de Mercado Pago). En Railway lo pone solo. ---
RAILWAY_PUBLIC_DOMAIN=localhost:8080

# --- Google OAuth (opcional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
